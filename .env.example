# Option A: OpenRouter (https://openrouter.ai/keys). Free models end with ":free".
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Reasoning off: the assistant makes short calls (80-token rewrites) that a
# reasoning model would spend thinking.
LLM_REASONING_EFFORT=none
# Free embedding model; empty = lexical search only.
EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
ALLOW_PAID_MODELS=0

# Option B: fully local with Ollama (`ollama serve`); no key needed.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# EMBED_MODEL=

# Hours a shared answer stays in the answer cache.
ANSWER_CACHE_TTL_HOURS=24
# 0 = never write recordings, usage or edits (read-only deployments).
# LLM_CACHE_WRITE=1
# DATA_WRITE=1
# Behind a reverse proxy: take the client address from X-Forwarded-For.
# TRUST_PROXY=1
HOST=127.0.0.1
PORT=4320
