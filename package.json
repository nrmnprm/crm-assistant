{
  "name": "crm-assistant-demo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "AI assistant inside a CRM: knowledge-base RAG, catalogue tools, daily briefing, cost control",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "index": "tsx scripts/build-index.ts",
    "catalog": "tsx scripts/make-catalog.ts",
    "record": "tsx scripts/record.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
